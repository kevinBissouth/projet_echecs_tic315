@startuml objets-validation
' Diagramme d'objets de validation (jalon J2) — vue partielle du plateau.
' Situation : partie en cours Alice (blancs) contre Bob (noirs), cadence 10 min + 5 s,
' après 1. e4 d5 2. exd5. Seules les cases et pièces concernées sont montrées.
' Points vérifiés : Participation, historique ordonné, rôles depart / arrivee /
' pieceJouee / piecePrise, pièce prise qui n'occupe plus de case, trait dérivé.

title Situation après 1. e4 d5 2. exd5 (vue partielle du plateau)

object "<u>partie : PartieEntreJoueurs</u>" as partie {
  etat = EN_COURS
  dateDebut = 2026-10-16 20:00
  /trait = NOIR
}

object "<u>alice : Joueur</u>" as alice {
  pseudo = "alice"
  email = "alice@exemple.com"
  etat = ACTIF
}

object "<u>bob : Joueur</u>" as bob {
  pseudo = "bob"
  email = "bob@exemple.com"
  etat = ACTIF
}

object "<u>pAlice : Participation</u>" as pAlice {
  couleur = BLANC
  tempsRestant = 9 min 58 s
}

object "<u>pBob : Participation</u>" as pBob {
  couleur = NOIR
  tempsRestant = 9 min 51 s
}

object "<u>c10p5 : Cadence</u>" as c10p5 {
  tempsDeBase = 10 min
  increment = 5 s
  categorie = RAPIDE
}

' Seuls les classements de la catégorie de la partie sont montrés (vue partielle)
object "<u>rapideAlice : Classement</u>" as rapideAlice {
  points = 1500
}
object "<u>rapideBob : Classement</u>" as rapideBob {
  points = 1480
}

object "<u>plateau : Plateau</u>" as plateau

object "<u>e2 : Case</u>" as e2 {
  colonne = 'e'
  rangee = 2
}
object "<u>e4 : Case</u>" as e4 {
  colonne = 'e'
  rangee = 4
}
object "<u>d7 : Case</u>" as d7 {
  colonne = 'd'
  rangee = 7
}
object "<u>d5 : Case</u>" as d5 {
  colonne = 'd'
  rangee = 5
}

object "<u>pionBlancE : Pion</u>" as pionBlancE {
  couleur = BLANC
  /aDejaBouge = true
}
object "<u>pionNoirD : Pion</u>" as pionNoirD {
  couleur = NOIR
  /aDejaBouge = true
}

object "<u>coup1 : Coup</u>" as coup1 {
  numero = 1
  /notation = "e4"
}
object "<u>coup2 : Coup</u>" as coup2 {
  numero = 2
  /notation = "d5"
}
object "<u>coup3 : Coup</u>" as coup3 {
  numero = 3
  /notation = "exd5"
}

' Participants et partie
partie -- alice
partie -- bob
(partie, alice) .. pAlice
(partie, bob) .. pBob
partie --> "createur" alice
partie --> c10p5
alice *-- rapideAlice : [categorie = RAPIDE]
bob *-- rapideBob : [categorie = RAPIDE]

' Plateau (composition) : cases et pièces montrées. Les liens sont écrits
' « e2 --* plateau » pour placer le plateau en bas ; le losange reste
' côté tout (le plateau), comme l'exige la composition.
e2 --* plateau
e4 --* plateau
d7 --* plateau
d5 --* plateau
pionBlancE --* plateau
pionNoirD --* plateau

' Seul le pion blanc occupe une case ; le pion noir pris n'en occupe plus
pionBlancE -- d5 : occupe

' Historique ordonné des coups
partie *-- coup1
partie *-- coup2
partie *-- coup3
coup1 -[hidden]right- coup2
coup2 -[hidden]right- coup3

coup1 --> e2 : depart
coup1 --> e4 : arrivee
coup1 --> pionBlancE : pieceJouee

coup2 --> d7 : depart
coup2 --> d5 : arrivee
coup2 --> pionNoirD : pieceJouee

coup3 --> e4 : depart
coup3 --> d5 : arrivee
coup3 --> pionBlancE : pieceJouee
coup3 --> pionNoirD : piecePrise

' Composition partie-plateau, déclarée en dernier pour ne pas contraindre la disposition
partie *-- plateau

@enduml
