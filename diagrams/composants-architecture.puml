@startuml composants-architecture
' Diagramme de composants (jalon J5) : les briques du système et leurs interfaces.
' Chaque composant interne regroupe les classes d'un package de la conception
' (packages-architecture.puml, classes-conception-*.puml).
' Interface fournie : trait plein vers l'interface. Interface requise : flèche
' pointillée vers l'interface (cours, §2.4.1). Les interfaces nommées sont celles de
' la conception : ce sont les points de remplacement du système.
' Dans un même processus, Serveur web → Contrôle → Métier sont de simples
' dépendances (flèche pointillée sans interface, permise par le cours) : ces
' couches ne sont pas destinées à être remplacées.
' Les composants « externes » ne sont pas développés par l'équipe.

skinparam componentStyle uml2
skinparam nodesep 45
skinparam ranksep 45

component "Site web\n(HTML, CSS, JavaScript)" as Site
interface "API web\n(HTTP, WebSocket)" as ApiWeb

package "Application Spring Boot" {
  component "Serveur web\n(ihm)" as ServeurWeb
  interface "ObservateurPartie" as IObservateur
  component "Contrôle\n(controle)" as Controle
  component "Métier\n(metier : partie, jeu, joueur)" as Metier

  interface "MoteurEchecs" as IMoteur
  interface "ServiceAuthentification" as IAuthentification
  interface "DepotParties" as IDepotParties
  interface "DepotJoueurs" as IDepotJoueurs

  component "Moteur\n(AdaptateurStockfish)" as AdaptateurMoteur
  component "Authentification\n(AdaptateurOpenIdConnect)" as AdaptateurAuthentification
  component "Persistance\n(DepotPartiesSql, DepotJoueursSql)" as Persistance
}

interface "UCI" as Uci
interface "OpenID Connect" as Oidc
component "Stockfish" <<externe>> as Stockfish
component "Fournisseur d'identité" <<externe>> as Fournisseur
database "Base de données" as Base

Site ..> ApiWeb
ApiWeb -- ServeurWeb

ServeurWeb ..> Controle
Controle .right.> Metier
ServeurWeb -right- IObservateur
Metier .up.> IObservateur

Controle ..> IMoteur
Controle ..> IAuthentification
Controle ..> IDepotParties
Controle ..> IDepotJoueurs

IMoteur -- AdaptateurMoteur
IAuthentification -- AdaptateurAuthentification
IDepotParties -- Persistance
IDepotJoueurs -- Persistance
Persistance ..> Metier

AdaptateurMoteur ..> Uci
Uci -- Stockfish
AdaptateurAuthentification ..> Oidc
Oidc -- Fournisseur
Persistance ..> Base : JDBC

@enduml
