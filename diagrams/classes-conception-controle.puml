@startuml classes-conception-controle
' Diagramme de classes de conception — ihm et ControleurPartie, du package controle
' (jalon J4). Décisions justifiées dans docs/conception.pdf :
' - MVC : la vue appelle le contrôleur ; la partie (modèle) prévient la vue par le
'   patron Observateur, sans la connaître ;
' - comptes et connexion : voir classes-conception-compte.puml, séparé pour rester lisible ;
' - Contrôleur (GRASP) : un ControleurPartie par session de joueur reçoit les
'   actions et délègue au métier ; il connaît le joueur connecté et sa partie ;
' - Adaptateur : les implémentations de MoteurEchecs, ServiceAuthentification et des
'   dépôts sont dans classes-conception-infrastructure.puml ;
' - inversion des dépendances (SOLID) et Fabrication pure (GRASP) : les interfaces
'   des services externes et des dépôts appartiennent à controle, leurs
'   implémentations à infrastructure ; le métier n'en dépend pas.
' - file d'actions par partie (FilesDeParties) : le serveur traite les joueurs en parallèle,
'   mais une partie traite une action à la fois ; le moteur réfléchit hors de la file ;
' - ArchivagePartie est un observateur : quand une partie se termine, il enregistre la partie
'   et ses joueurs, puis libère sa file.
' Les classes de metier ne montrent que leur nom (voir classes-conception-*.puml).

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam nodesep 20
skinparam ranksep 50
' Boîtes des classes de metier assez larges pour que leurs rôles ne se superposent pas.
skinparam minClassWidth 135

package ihm {
  class VuePartie {
    + actualiser(partie : Partie)
    + afficherRefus(motif : String)
  }
}

package controle {
  class ControleurPartie {
    - horloge : Clock
    + creerPartie(cadence : Cadence, couleur : Couleur [0..1], invite : Joueur [0..1]) : PartieEntreJoueurs
    + consulterPartiesOuvertes() : List<PartieEntreJoueurs>
    + rejoindrePartie(partie : PartieEntreJoueurs)
    + refuserInvitation(partie : PartieEntreJoueurs)
    + annulerPartie()
    + jouerCoup(depart : String, arrivee : String, promotion : TypePromotion [0..1]) : Coup
    + proposerNulle()
    + repondreNulle(accepte : boolean)
    + abandonner()
    + demarrerPartieContreOrdinateur(force : int, couleur : Couleur)
    + revoirPartie(partie : Partie) : List<Coup>
    - faireJouerOrdinateur(partie : PartieContreOrdinateur)
  }

  ' Ce que le site peut demander : les opérations publiques du contrôleur.
  interface IPartie <<interface>>

  interface MoteurEchecs <<interface>> {
    + calculerCoup(position : String, force : int) : String
  }

  interface DepotParties <<interface>> {
    + enregistrer(partie : Partie)
    + partiesOuvertes() : List<PartieEntreJoueurs>
    + partieActiveDe(joueur : Joueur) : Partie [0..1]
    + partiesTermineesDe(joueur : Joueur) : List<Partie>
  }

  interface DepotJoueurs <<interface>> {
    + enregistrer(joueur : Joueur)
    + trouverParEmail(email : String) : Joueur [0..1]
    + pseudoExiste(pseudo : String) : boolean
    + tous() : List<Joueur>
  }

  class FilesDeParties {
    + executer(partie : Partie, action : Supplier<T>) : T
    + verifierToutesLesPendules()
    ~ ajouter(partie : Partie)
    ~ liberer(partie : Partie)
  }

  class ArchivagePartie {
    + actualiser(partie : Partie)
  }

  class MoteurIndisponibleException
  class ActionRefuseeException
}

package metier {
  class Partie
  class Joueur
  interface ObservateurPartie <<interface>>
  interface CalculClassement <<interface>>
}

ObservateurPartie <|.. VuePartie
ObservateurPartie <|.. ArchivagePartie
IPartie <|.. ControleurPartie

VuePartie "1" --> "1\ncontroleur" IPartie
ControleurPartie "0..1" --> "          1 vue" ObservateurPartie
ControleurPartie "        0..1" --> "1 joueurConnecte" Joueur
ControleurPartie "  0..*" --> "0..1 partieCourante" Partie
ControleurPartie "0..*" --> "1\nmoteur" MoteurEchecs
ControleurPartie "  0..*" --> "            1 calcul" CalculClassement
ControleurPartie "0..*" --> "1\ndepotParties" DepotParties
ControleurPartie "0..*" --> "1\nfiles" FilesDeParties
ControleurPartie "1" *--> "1\narchivage" ArchivagePartie
ArchivagePartie "0..*" --> "1\ndepotParties" DepotParties
ArchivagePartie "0..*" --> "1\ndepotJoueurs" DepotJoueurs
ArchivagePartie "0..*" --> "1\nfiles" FilesDeParties

MoteurEchecs ..> MoteurIndisponibleException : <<throws>>
ControleurPartie ..> ActionRefuseeException : <<throws>>

@enduml
