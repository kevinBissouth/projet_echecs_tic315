@startuml classes-conception-partie
' Diagramme de classes de conception — package metier.partie (jalon J4).
' Issu du modèle du domaine (classes-domaine.puml) ; les décisions sont justifiées
' dans docs/conception.pdf.
' Patron État : la partie délègue à son état courant ; ses classes sont détaillées
' dans classes-conception-etat.puml, séparé pour rester lisible une fois imprimé.
' Les observateurs sont les écrans des deux joueurs : le système ne gère pas de spectateurs.
' Patron Observateur : la partie notifie ses observateurs (les vues, MVC) sans les
' connaître ; modèle « tiré » : l'observateur relit la partie qu'on lui passe.
' Refus du coup (pas son trait, coup illégal : refus(motif) de sequence-jouer-coup) :
' CoupRefuseException, distincte d'un événement refusé dans l'état courant.
' Patron Stratégie : la partie entre joueurs délègue le calcul des points.
' Le coup de l'ordinateur suit le même chemin que celui d'un joueur : joueur est
' alors absent ([0..1]), et jouerCoupOrdinateur() vérifie lui-même le trait.
' Polymorphisme : apresCoup() (pendules, proposition de nulle retirée), demarrer()
' et mettreAJourClassements() ne font leur travail que dans PartieEntreJoueurs.
' Types Java : Instant pour les dates, Duration pour les durées, Clock pour l'heure
' (horloge remplaçable dans les tests JUnit). Accesseurs simples omis.
' Visibilité ~ (package) : réservée aux classes d'état, du même package.
' Les classes des autres packages ne montrent que leur nom.

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 70
left to right direction

package metier.partie {

  abstract class Partie {
    - dateDebut : Instant [0..1]
    - dateFin : Instant [0..1]
    - resultat : Resultat [0..1]
    - motifFin : MotifFin [0..1]
    - horloge : Clock {readOnly}
    + etat() : EtatPartie
    + trait() : Couleur
    + position() : String
    + jouerCoup(joueur : Joueur, depart : Case, arrivee : Case, promotion : TypePromotion [0..1]) : Coup
    + annuler(joueur : Joueur)
    + annulerParLeSysteme()
    + abandonner(joueur : Joueur)
    + abonner(observateur : ObservateurPartie)
    + desabonner(observateur : ObservateurPartie)
    ~ etatCourant() : EtatDePartie
    ~ changerEtat(etat : EtatDePartie)
    ~ demarrer()
    ~ executerCoup(joueur : Joueur [0..1], depart : Case, arrivee : Case, promotion : TypePromotion [0..1]) : Coup
    ~ terminer(resultat : Resultat, motif : MotifFin)
    ~ cloreSansResultat()
    ~ nombreCoupsJoues() : int
    ~ motifDeFin() : MotifFin [0..1]
    ~ resultatDe(motif : MotifFin) : Resultat
    ~ estParticipant(joueur : Joueur) : boolean
    ~ couleurDe(joueur : Joueur) : Couleur [0..1]
    ~ ajouterParticipation(participation : Participation)
    ~ maintenant() : Instant
    ~ notifierObservateurs()
    # apresCoup()
    # mettreAJourClassements()
    - verifierTrait(joueur : Joueur)
    - verifierNullesAutomatiques() : MotifFin [0..1]
  }

  class PartieEntreJoueurs {
    - nulleProposeePar : Couleur [0..1]
    + jouerCoup(joueur : Joueur, depart : Case, arrivee : Case, promotion : TypePromotion [0..1]) : Coup
    + rejoindre(joueur : Joueur)
    + refuserInvitation(joueur : Joueur)
    + proposerNulle(joueur : Joueur)
    + accepterNulle(joueur : Joueur)
    + refuserNulle(joueur : Joueur)
    + verifierTemps()
    ~ demarrer()
    ~ peutEtreRejointePar(joueur : Joueur) : boolean
    ~ estInvite(joueur : Joueur) : boolean
    ~ aRecuUneProposition(joueur : Joueur) : boolean
    ~ ajouterAdversaire(joueur : Joueur)
    ~ enregistrerPropositionNulle(couleur : Couleur [0..1])
    # apresCoup()
    # mettreAJourClassements()
    - attribuerCouleurs()
  }

  class PartieContreOrdinateur {
    - force : int {readOnly}
    + ordinateurALeTrait() : boolean
    + jouerCoupOrdinateur(depart : Case, arrivee : Case, promotion : TypePromotion [0..1]) : Coup
  }

  class Participation {
    - couleur : Couleur [0..1]
    - tempsRestant : Duration [0..1]
    - debutTour : Instant [0..1]
    + definirCouleur(couleur : Couleur)
    + demarrerPendule(maintenant : Instant)
    + arreterPendule(maintenant : Instant, increment : Duration)
    + tempsEcoule(maintenant : Instant) : boolean
  }

  class Cadence {
    + {static} DISPONIBLES : List<Cadence> {readOnly}
    - tempsDeBase : Duration {readOnly}
    - increment : Duration {readOnly}
    - categorie : CategorieCadence {readOnly}
  }

  abstract class EtatDePartie

  interface ObservateurPartie <<interface>> {
    + actualiser(partie : Partie)
  }

  class CoupRefuseException {
    + CoupRefuseException(motif : String)
  }

  enum Resultat <<enumeration>> {
    VICTOIRE_BLANCS
    VICTOIRE_NOIRS
    NULLE
    ~ {static} victoireDe(couleur : Couleur) : Resultat
  }
}

package metier.jeu {
  class Plateau
  class Coup
}

package metier.joueur {
  class Joueur
  interface CalculClassement <<interface>>
}

Partie <|-- PartieEntreJoueurs
Partie <|-- PartieContreOrdinateur

Partie "0..*" --> "1 etatCourant" EtatDePartie
Partie "1" *--> "1..2\nparticipations" Participation
Participation "0..*" --> "1 joueur" Joueur
Partie "0..*" o--> "0..*\nobservateurs" ObservateurPartie
Partie "                1" *--> "1 plateau" Plateau
Partie "          1" *--> "0..* coups {ordered}" Coup

PartieEntreJoueurs "0..*" --> "1 createur" Joueur
PartieEntreJoueurs "0..*" --> "0..1 invite" Joueur
PartieEntreJoueurs "0..*" --> "1 cadence" Cadence
PartieEntreJoueurs "0..*" o--> "1 calcul" CalculClassement

Partie ..> CoupRefuseException : <<throws>>

@enduml
